# GEMINI_API_KEY: Required for server-side Gemini AI API calls (Camellia, AI Verification, Resume Drafting).
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY=

# MRS_GEMINI_MODEL: Optional server-side Gemini model identifier (defaults internally to gemini-4-hydrogen).
MRS_GEMINI_MODEL=

# APP_URL: Hosted application URL (injected automatically on Cloud Run).
APP_URL=

# OWNER_EMAIL: Owner notification & reply-to email address.
OWNER_EMAIL=

# Server Security & Webhook Secrets (configure in Settings > Secrets)
MRS_ADMIN_PASSWORD=
MRS_SMS_SIGNING_KEY=
MRS_INGEST_SECRET=
MRS_CRON_SECRET=

# GRAVATAR_API_KEY: Gravatar REST API v3 key for live owner profile synchronization.
GRAVATAR_API_KEY=
GRAVATAR_PROFILE_SLUG=

# FIREBASE_SERVICE_ACCOUNT: Optional Firebase Admin service account JSON for server-side Cloud Firestore sync.
# FIREBASE_SERVICE_ACCOUNT=

# Outbound Transactional & Activation Email Transport (configure Resend or SMTP in Server Secrets)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
